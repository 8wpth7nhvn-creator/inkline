# Inkline AI settings.
# Copy this file to .env and fill in your own values. NEVER commit .env (it is in .gitignore).
# Best place for .env on a host: one folder ABOVE the website folder (for example above public_html),
# where no browser can reach it. A .env inside the website folder also works and is blocked by .htaccess.
# Real environment variables (or SetEnv in .htaccess) override anything in this file.

# ---------- AI provider ----------
# openai, anthropic, or auto (uses whichever key is set, OpenAI first)
AI_PROVIDER=auto

# Your OpenAI key, from platform.openai.com > API keys. Server-side only; never put it in browser code.
OPENAI_API_KEY=
# Model for the interview and for reading uploaded CVs (a low-cost default)
OPENAI_MODEL=gpt-5.4-mini
# Reasoning effort for reasoning models: none, minimal, low, medium, high. Leave empty for models without it.
OPENAI_REASONING_EFFORT=low

# Alternative: Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Largest answer the AI may write, in tokens (caps the cost of every single request)
AI_MAX_OUTPUT_TOKENS=8000
AI_TIMEOUT_SECONDS=90

# ---------- Speed limits (per visitor; per account once accounts exist) ----------
# Minimum time between two AI requests, in milliseconds
AI_MIN_MS_BETWEEN_REQUESTS=1200
# At most this many requests within AI_BURST_WINDOW_SECONDS
AI_BURST_LIMIT=4
AI_BURST_WINDOW_SECONDS=10
AI_RATE_LIMIT_PER_MINUTE=12
AI_RATE_LIMIT_PER_HOUR=80
# Breaking the fast-request rules this many times in 10 minutes pauses the visitor for AI_BLOCK_MINUTES
AI_STRIKES_BEFORE_BLOCK=3
AI_BLOCK_MINUTES=15

# ---------- Daily limits ----------
# New AI CVs per visitor per day (each new AI chat or old-CV upload starts one)
AI_DAILY_CV_LIMIT=5
# AI requests per visitor per day (each chat message or upload is one)
AI_DAILY_REQUEST_LIMIT=150
# Old-CV uploads per visitor per day
AI_DAILY_UPLOAD_LIMIT=10
# AI requests for the WHOLE site per day: a hard ceiling on your costs
AI_GLOBAL_DAILY_REQUEST_LIMIT=3000
# Messages allowed in one CV chat
AI_MAX_TURNS_PER_CV=60

# ---------- Request size limits ----------
# Longest message a visitor can send, in characters
AI_MAX_MESSAGE_CHARS=4000
# Longest text taken from an uploaded document, in characters
AI_MAX_IMPORT_TEXT_CHARS=40000
# Conversation size before older turns are folded into a short summary
AI_MAX_HISTORY_CHARS=120000
# Uploads: per file, all files together, and how many at once (PDF, JPG, PNG, WebP, GIF only)
UPLOAD_MAX_FILE_MB=8
UPLOAD_MAX_TOTAL_MB=10
UPLOAD_MAX_FILES=6

# ---------- Privacy ----------
# Chats are deleted from the server after this many hours (uploaded files are never stored at all)
CONVERSATION_RETENTION_HOURS=24

# ---------- Network and storage ----------
# Only set to true if the site is behind a proxy you control (for example Cloudflare);
# otherwise visitors could fake their IP address to dodge limits.
TRUST_PROXY_HEADERS=false
# Extra web addresses allowed to call the AI (comma separated), if your site has more than one domain
ALLOWED_ORIGINS=
# Folder for rate limits, chats and logs. Must be OUTSIDE the website folder. Default: ../inkline-data
INKLINE_DATA_DIR=
# Optional secret used to anonymise IP addresses (32+ random characters). Created automatically if empty.
APP_SECRET=
# Security log (no CV contents, no IP addresses, no keys). true or false.
AI_LOGGING=true

# For local testing against a fake AI server only. Leave empty in production.
OPENAI_BASE_URL=
ANTHROPIC_BASE_URL=
